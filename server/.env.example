# Copy this file to .env and fill in real values.
#   cp .env.example .env

# HTTP server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string. Create the database first:
#   createdb collabcode_dev
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/collabcode_dev?schema=public"

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Origin allowed to call the API and open websocket connections.
# In development this is the Vite dev server.
CLIENT_ORIGIN="http://localhost:5173"

# Test database URL used by vitest (see .env.test)
# Copy to .env.test and point DATABASE_URL at a separate database:
#   createdb collabcode_test
